// Cloudflare Worker that serves the static site in ./public (no server code).
// Pushes to main deploy automatically (Workers Builds runs `npx wrangler deploy`).
{
  "name": "contrail-app",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
